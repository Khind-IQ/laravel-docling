{
    "name": "khind-iq/laravel-docling",
    "description": "Laravel client for docling-serve: OCR and document-to-markdown conversion with automatic large-PDF chunking.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "docling",
        "docling-serve",
        "ocr",
        "pdf",
        "document-conversion"
    ],
    "authors": [
        {
            "name": "Zulkifli Zin"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.4",
        "psr/log": "^2.0|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.21|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "KhindIq\\Docling\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KhindIq\\Docling\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KhindIq\\Docling\\DoclingServiceProvider"
            ],
            "aliases": {
                "Docling": "KhindIq\\Docling\\Facades\\Docling"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}